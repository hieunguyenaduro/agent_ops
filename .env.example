# Sao chép file này thành .env rồi điền giá trị thật.
# Tuyệt đối không commit .env lên git.

# --- Model ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Phiên bản ứng dụng ---
APP_VERSION=0.1.0

# --- Langfuse (bỏ trống nếu chưa dùng) ---
# Lấy key tại: Project Settings > API Keys
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com
